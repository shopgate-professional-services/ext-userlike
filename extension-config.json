{
  "id": "@shopgate-project/userlike",
  "version": "1.4.0",
  "components": [
    {
      "id": "Subscribers",
      "path": "frontend/subscriptions.js",
      "type": "subscribers"
    }
  ],
  "configuration": {
    "integrationType": {
      "type": "admin",
      "destination": "frontend",
      "default": "auto",
      "params": {
        "type": "select",
        "label": "Integration method",
        "description": "'auto' uses the JavaScript SDK file if only an SDK URL is configured, otherwise the widget key. 'widgetKey' and 'sdkUrl' force the respective method.",
        "required": true,
        "options": {
          "multiple": false,
          "options": [
            {
              "label": "Auto-detect",
              "value": "auto"
            },
            {
              "label": "Widget Key",
              "value": "widgetKey"
            },
            {
              "label": "JavaScript SDK file",
              "value": "sdkUrl"
            }
          ]
        }
      }
    },
    "widgetKey": {
      "type": "admin",
      "destination": "frontend",
      "default": "",
      "params": {
        "type": "text",
        "label": "Userlike Widget Key",
        "description": "Used with integration method 'widgetKey', and by 'auto' whenever it is set."
      }
    },
    "sdkUrl": {
      "type": "admin",
      "destination": "frontend",
      "default": "",
      "params": {
        "type": "text",
        "label": "Url of userlike JavaScript sdk",
        "description": "Used with integration method 'sdkUrl', and by 'auto' when no widget key is set."
      }
    },
    "pagesWithoutWidget": {
      "type": "admin",
      "destination": "frontend",
      "default":[
        "/cart",
        "/login"
      ],
      "params": {
        "type": "json",
        "label": "Page patterns which should not have the chat widget"
      }
    },
    "iframeChatTitle": {
      "type": "admin",
      "destination": "frontend",
      "default": "Chat",
      "params": {
        "type": "json",
        "label": "Specifies the title attribute of the chat iframe"
      }
    },
    "iframeBackgroundColor": {
      "type": "admin",
      "destination": "frontend",
      "default": "",
      "params": {
        "type": "json",
        "label": "Defines the background color of the iframe"
      }
    }
  }
}
