{
  "id": "@shopgate-project/userlike",
  "version": "1.3.0",
  "components": [
    {
      "id": "Subscribers",
      "path": "frontend/subscriptions.js",
      "type": "subscribers"
    }
  ],
  "configuration": {
    "widgetKey": {
      "type": "admin",
      "destination": "frontend",
      "default": "",
      "params": {
        "type": "text",
        "label": "Userlike Widget Key"
      }
    },
    "pagesWithoutWidget": {
      "type": "admin",
      "destination": "frontend",
      "default":[
        "/cart",
        "/login"
      ],
      "params": {
        "type": "json",
        "label": "Page patterns which should not have the chat widget"
      }
    },
    "iframeChatTitle": {
      "type": "admin",
      "destination": "frontend",
      "default": "Chat",
      "params": {
        "type": "json",
        "label": "Specifies the title attribute of the chat iframe"
      }
    },
    "iframeBackgroundColor": {
      "type": "admin",
      "destination": "frontend",
      "default": "",
      "params": {
        "type": "json",
        "label": "Defines the background color of the iframe"
      }
    }
  }
}
